---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Search from '../components/Search.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === 'Study')
  .map((a) => a.data);
---

<BaseLayout title="Study" description="Desk setup, tools & quiet focus — discovered for you.">
  <Header slot="header" currentPage="study" />
  <section class="section">
    <div class="container">
      <div class="page-header">
        <h1 class="section-title">Study</h1>
        <p class="page-desc">Desk setup, tools & quiet focus</p>
      </div>
      <Search />
      <div class="divider" aria-hidden="true">
        <span class="divider-symbol">✧</span>
      </div>
      <div class="card-grid">
        {articles.map((a) => (
          <ArticleCard title={a.title} excerpt={a.excerpt} slug={a.slug} category={a.category} image={a.image} date={a.date} />
        ))}
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-header { margin-bottom: 2rem; }
  .page-desc { color: var(--sand); font-size: 1.05rem; margin-top: 0.5rem; }
</style>
