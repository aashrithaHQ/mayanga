---
export interface Props {
  image: string;
  caption: string;
  link: string;
  rotation?: number;
  x?: number;
  y?: number;
}

const { image, caption, link, rotation = 0, x = 0, y = 0 } = Astro.props;
---

<a href={link} class="polaroid" style={`--rot: ${rotation}deg; --x: ${x}px; --y: ${y}px;`}>
  <span class="polaroid-image">
    <img src={image} alt={caption} loading="lazy" />
  </span>
  <span class="polaroid-caption cursive">{caption}</span>
</a>

<style>
  .polaroid {
    display: block;
    width: 100%;
    max-width: 220px;
    background: var(--white);
    padding: 10px 10px 20px;
    box-shadow: 0 4px 20px rgba(44, 24, 16, 0.1);
    transform: rotate(var(--rot));
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    text-decoration: none;
    opacity: 0;
    animation: polaroid-enter 0.8s ease forwards;
  }
  .polaroid:hover {
    transform: rotate(0deg) scale(1.05);
    box-shadow: 0 8px 40px rgba(44, 24, 16, 0.18);
    z-index: 10;
  }
  .polaroid-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--ivory-dark);
  }
  .polaroid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .polaroid:hover .polaroid-image img {
    transform: scale(1.05);
  }
  .polaroid-caption {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    color: var(--brown);
    margin-top: 8px;
    line-height: 1.3;
  }

  @keyframes polaroid-enter {
    from {
      opacity: 0;
      transform: rotate(var(--rot)) scale(0.92);
    }
    to {
      opacity: 1;
      transform: rotate(var(--rot)) scale(1);
    }
  }

  @media (max-width: 640px) {
    .polaroid {
      max-width: 160px;
      padding: 6px 6px 14px;
    }
    .polaroid-caption {
      font-size: 0.75rem;
      margin-top: 5px;
    }
  }
</style>
