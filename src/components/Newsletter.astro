---
const { dark } = Astro.props;
---

<form class="newsletter-form" data-newsletter>
  <label class="newsletter-label cursive" for="newsletter-email">Join the muse letter</label>
  <div class="newsletter-input-row">
    <input type="email" id="newsletter-email" placeholder="your@email.com" required />
    <button type="submit" class="btn btn-primary">Subscribe</button>
  </div>
  <p class="newsletter-note">No spam. Just beautiful things.</p>
</form>

<style>
  .newsletter-label {
    display: block;
    font-size: 1.2rem;
    color: var(--brown);
    margin-bottom: 0.75rem;
  }
  .newsletter-input-row {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter-input-row input {
    flex: 1;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    background: var(--white);
    color: var(--brown);
    outline: none;
    min-width: 0;
  }
  .newsletter-input-row input:focus {
    border-color: var(--rose);
  }
  .newsletter-input-row input::placeholder {
    color: var(--sand);
}
  .newsletter-note {
    font-size: 0.75rem;
    color: var(--sand);
    margin-top: 0.5rem;
    font-style: italic;
  }
  @media (max-width: 480px) {
    .newsletter-input-row {
      flex-direction: column;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector('input');
      if (input && input.value) {
        alert('Thank you for subscribing! (Newsletter integration coming soon.)');
        input.value = '';
      }
    });
  });
</script>
