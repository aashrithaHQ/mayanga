---
const categories = [
  { slug: 'art', label: 'Art', desc: 'Paintings, prints & creative supplies' },
  { slug: 'beauty', label: 'Beauty', desc: 'Skincare, makeup & self-care rituals' },
  { slug: 'fashion', label: 'Fashion', desc: 'Clothing, accessories & jewellery' },
  { slug: 'curio', label: 'Curio', desc: 'Decor, curiosities & the aesthetic life' },
  { slug: 'stationery', label: 'Stationery', desc: 'Notebooks, pens & paper goods' },
  { slug: 'study', label: 'Study', desc: 'Desk setup, tools & quiet focus' },
];
---

<nav class="category-nav" aria-label="Product categories">
  <div class="container">
    <div class="category-grid">
      {categories.map((cat) => (
        <a href={`/mayanga/${cat.slug}/`} class="category-item">
          <span class="category-name">{cat.label}</span>
          <span class="category-desc">{cat.desc}</span>
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .category-nav {
    padding: 3rem 0;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .category-item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: var(--white);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
  .category-item:hover {
    border-color: var(--rose);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(44, 24, 16, 0.06);
  }
  .category-name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--brown);
    margin-bottom: 0.3rem;
  }
  .category-desc {
    font-size: 0.85rem;
    color: var(--sand);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
